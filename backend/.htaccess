RewriteEngine On

# Never serve internals
RewriteRule ^(src|storage|tools)(/|$) - [F,L]
RewriteRule ^(config\.php|config\.sample\.php|schema\.sql|\.htaccess)$ - [F,L]

# Pass the Authorization header through on shared hosting (CGI/FastCGI)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Everything else -> front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
</IfModule>
